# Application
NODE_ENV=development
MODE=local
PORT=3000
API_PORT=3000

# PostgreSQL (app expects POSTGRES_*; DATABASE_* kept for docker-compose compatibility)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=estore
POSTGRES_USER=estore
POSTGRES_PASSWORD=estore

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=estore
DATABASE_USER=estore
DATABASE_PASSWORD=estore

# Optional single connection string (some ORMs use this)
# DATABASE_URL=postgresql://estore:estore@localhost:5432/estore

# Auth/Secrets
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Mailer
MAIL_USER=
MAIL_PASS=
MAIL_FROM="E-Store <noreply@example.com>"

# Integrations (optional)
MSEGAT_USER_NAME=
MSEGAT_API_KEY=
MSEGAT_USER_SENDER=
LOGSTASH_BASE_URL=
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USER_NAME=
TTLOCK_USER_PASSWORD=

# Spaces (optional)
SPACES_ENABLED=false
SPACES_ENDPOINT=
SPACES_REGION=ams3
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
